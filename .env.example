# VaultPay Guard — environment configuration (copy to .env, never commit .env)

# --- PayPal sandbox (Orders API v2) -------------------------------------
# Create a sandbox app at https://developer.paypal.com/dashboard/applications/sandbox
# With no credentials set, the PayPal client runs in SIMULATED mode:
# it mimics the sandbox API responses locally and no money moves anywhere.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox (default) or live. This project targets the sandbox.
PAYPAL_ENV=sandbox

# --- AI provider (optional) ----------------------------------------------
# Any OpenAI-compatible endpoint. With no key set, the deterministic MOCK
# backend is used (offline demos and the whole test suite run on it).
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- Local files ----------------------------------------------------------
# Policy config (caps, allowlist, currencies). See config/policy.example.json
VAULTPAY_POLICY=config/policy.example.json
# Audit ledger (JSONL, one full decision record per line)
VAULTPAY_LEDGER=data/audit-ledger.jsonl
# Deployment-facing aliases for the same two paths (used by render.yaml);
# when both are set, POLICY_PATH / LEDGER_PATH win.
POLICY_PATH=config/policy.example.json
LEDGER_PATH=data/audit-ledger.jsonl

# --- Web server (app.py) ----------------------------------------------------
# Port/interface for the web UI. Render sets PORT itself.
PORT=8000
HOST=0.0.0.0
